# Infrastructure
# Pooled PostgreSQL connection used by src/db/** for all app query traffic.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_opportunities
# Direct (unpooled) connection for migrations, dumps, and replication.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/news_opportunities
# Max connections held by the pg pool.
PG_POOL_MAX=10
# Neon branch name (Neon-hosted databases only).
NEON_BRANCH=production

# LLM
# Required at runtime (not required under NODE_ENV=test).
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Alternative providers consumed by src/services/llmGateway.ts.
COHERE_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
# Default chat model for the LLM gateway.
LLM_MODEL=qwen/qwen3.8-max
LLM_MAX_RETRIES=5
# Voyage AI embeddings (voyage-4, 1024 dims).
VOYAGE_API_KEY=
VOYAGE_MIN_INTERVAL_MS=22000
# LLM caching + per-minute rate limit.
LLM_CACHE_ENABLED=true
LLM_RATE_LIMIT_PER_MIN=20

# Pipeline
# Orchestrator polling, per-stage timeout, and retry budget.
PIPELINE_POLL_MS=3000
PIPELINE_TIMEOUT_MS=600000
PIPELINE_MAX_RETRIES=3
DRY_RUN=false
BATCH_SIZE=250
# GDELT ingestion source + line cap (0 = unlimited).
GDELT_API_URL=
GDELT_URL=
GDELT_MAX_LINES=0
# Ingestion relevance thresholds.
MIN_RELEVANCE_SCORE=0.35
MIN_NUM_MENTIONS=2
MIN_TONE=-10.0
MAX_TONE=10.0
MIN_GOLDSTEIN_SCALE=-10.0
MAX_GOLDSTEIN_SCALE=10.0
# Targeting & filtering.
TARGET_SECTORS=business,innovation,investment,technology,startups,logistics,energy,fintech,healthtech,manufacturing,climate,market,regulatory
PRIORITY_COUNTRIES=IN,US,GB,SG,AE,DE,JP
CUSTOM_KEYWORDS=funding,startup,acquisition,expansion,policy,tariff,subsidy,semiconductor,renewable,ev,supply chain
