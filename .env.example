# Database connection (PostgreSQL)
DATABASE_URL=

# LLM Gateway settings (OpenAI-compatible endpoints e.g. Groq, Together, Ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=3

# Ingestion & relevance thresholds
MIN_RELEVANCE_SCORE=0.35
MIN_NUM_MENTIONS=2
MIN_TONE=-10
MAX_TONE=10

# Pipeline execution options
BATCH_SIZE=250
GDELT_MAX_LINES=0
