
# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_opportunities

# Ingestion Relevance Configuration
MIN_RELEVANCE_SCORE=0.35
MIN_NUM_MENTIONS=2
MIN_TONE=-10.0
MAX_TONE=10.0
MIN_GOLDSTEIN_SCALE=-10.0
MAX_GOLDSTEIN_SCALE=10.0

# Targeting & Filtering
# Sectors to prioritize (business, innovation, investment, technology, startups, logistics, energy, fintech, healthtech, manufacturing, climate, market, regulatory)
TARGET_SECTORS=business,innovation,investment,technology,startups,logistics,energy,fintech,healthtech,manufacturing,climate,market,regulatory

# Country priority weighting (e.g., IN for India, US, GB, etc.)
PRIORITY_COUNTRIES=IN,US,GB,SG,AE,DE,JP

# Additional custom domain keywords for relevance matching
CUSTOM_KEYWORDS=funding,startup,acquisition,expansion,policy,tariff,subsidy,semiconductor,renewable,ev,supply chain

# Pipeline Execution Options
DRY_RUN=false
BATCH_SIZE=250
GDELT_MAX_LINES=0
