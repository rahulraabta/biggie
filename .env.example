# Infrastructure (eager — required at startup)
DATABASE_URL=postgres://user:pass@host:5432/dbname
PG_POOL_MAX=10

# Pipeline knobs (defaults shown)
PIPELINE_POLL_MS=3000
PIPELINE_TIMEOUT_MS=600000
PIPELINE_MAX_RETRIES=3
PIPELINE_MAX_PENDING_INGESTION=500
PIPELINE_MAX_PENDING_OPPORTUNITY=200

# LLM cache / rate limit
LLM_CACHE_ENABLED=true
LLM_RATE_LIMIT_PER_MIN=20

# LLM (lazy — only required when an agent actually calls an LLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8318/v1
GDELT_API_URL=
LLM_MODEL=qwen/qwen3.8-max

# Alternate providers (optional)
COHERE_API_KEY=
VOYAGE_API_KEY=
VOYAGE_MIN_INTERVAL_MS=200
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:8318/v1
LLM_MAX_RETRIES=3

# Direct Neon connection for ingestion and migrations; SSE uses DATABASE_URL
DATABASE_URL_UNPOOLED=
